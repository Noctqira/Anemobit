msgid "SNMP error {0} (varbind {1})"
msgstr "SNMP 오류 {0}(varbind {1})"

#: src/text.rs:78
msgid "Connection timed out"
msgstr "연결 시간이 초과되었습니다"

#: src/text.rs:80
