msgstr "인터페이스 {}을(를) 찾을 수 없습니다"

#: src/text.rs:83
msgid "Connection error: {}"
msgstr "연결 오류: {}"

#: src/text.rs:91
msgid "Unknown user name"
msgstr "사용자 이름이 올바르지 않습니다"

#: src/text.rs:92
msgid "Wrong authentication password or protocol"
msgstr "인증 비밀번호 또는 인증 프로토콜이 올바르지 않습니다"

#: src/text.rs:93
msgid "Wrong privacy password or protocol"
msgstr "암호화 비밀번호 또는 암호화 프로토콜이 올바르지 않습니다"

#: src/text.rs:95
msgid "Security level does not match the device configuration"
msgstr "보안 수준이 장치 설정과 일치하지 않습니다"

#: src/text.rs:97
msgid "Time synchronization with the device failed"
msgstr "장치와의 시간 동기화에 실패했습니다"

#: src/text.rs:98
msgid "Device engine ID mismatch"
msgstr "장치 engine ID가 일치하지 않습니다"

#: src/text.rs:100
msgid ""
"The device did not answer the encrypted request. Check the privacy password "
"and protocol."
msgstr ""
"장치가 암호화된 요청에 응답하지 않았습니다. 암호화 비밀번호와 프로토콜을 확인"
"하세요."

#: src/text.rs:102
msgid "SNMPv3 discovery has not completed"
msgstr "SNMPv3 검색이 완료되지 않았습니다"

#: src/text.rs:104
msgid "The authentication password must be at least {} characters"
msgstr "인증 비밀번호는 {}자 이상이어야 합니다"

#: src/text.rs:108
msgid "The privacy password must be at least {} characters"
msgstr "암호화 비밀번호는 {}자 이상이어야 합니다"

#: src/text.rs:111
msgid "Invalid encryption parameters"
msgstr "암호화 매개변수가 잘못되었습니다"

#: src/text.rs:118
msgid "Enter a community"
msgstr "community를 입력하세요"

#: src/text.rs:119
msgid "Enter a user name"
msgstr "사용자 이름을 입력하세요"

#: src/text.rs:127
msgid "Enter the device address"
msgstr "장치 주소를 입력하세요"

#: src/text.rs:128
msgid "Enter a valid IPv4 or IPv6 address, or a host name"
msgstr "유효한 IPv4 또는 IPv6 주소나 호스트 이름을 입력하세요"

#: src/text.rs:129
msgid "Port must be 1–65535"
msgstr "Port는 1–65535 사이여야 합니다"

#: src/text.rs:137
msgid "SNMPv2c with a community only."
msgstr "SNMPv2c(community만 사용)."

#: src/text.rs:138
msgid "SNMPv3 with authentication."
msgstr "SNMPv3(인증만)."

#: src/text.rs:139
msgid "SNMPv3 with authentication and encryption."
msgstr "SNMPv3(인증 및 암호화)."

