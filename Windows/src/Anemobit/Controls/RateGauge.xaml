<UserControl x:Class="Anemobit.Controls.RateGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Anemobit.Controls"
             x:Name="Root">
  <!-- 270° ring rate gauge: track, value arc (glowing), direction / value / unit in the center, maximum at the bottom. -->
  <Viewbox Stretch="Uniform" StretchDirection="Both">
    <Grid Width="200" Height="200">
      <controls:GaugeArc Fraction="1"
                         Stroke="{DynamicResource TrackBrush}"
                         StrokeThickness="{Binding ArcThickness, ElementName=Root}" />
      <controls:GaugeArc Animates="True"
                         Fraction="{Binding Fraction, ElementName=Root}"
                         StrokeThickness="{Binding ArcThickness, ElementName=Root}">
        <controls:GaugeArc.Stroke>
          <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
            <GradientStop Offset="0" Color="{Binding FadedColor, ElementName=Root}" />
            <GradientStop Offset="1" Color="{Binding Color, ElementName=Root}" />
          </LinearGradientBrush>
        </controls:GaugeArc.Stroke>
        <controls:GaugeArc.Effect>
          <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="{Binding GlowOpacity, ElementName=Root}"
                            Color="{Binding Color, ElementName=Root}" />
        </controls:GaugeArc.Effect>
      </controls:GaugeArc>

      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,6">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center"
                     Text="{Binding Glyph, ElementName=Root}" Foreground="{Binding Brush, ElementName=Root}" />
          <TextBlock Margin="4,0,0,0" FontSize="12" FontWeight="SemiBold"
                     Text="{Binding Title, ElementName=Root}" Foreground="{Binding Brush, ElementName=Root}" />
        </StackPanel>
        <TextBlock HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold"
                   FontSize="{Binding ValueFontSize, ElementName=Root}" Typography.NumeralAlignment="Tabular"
                   Text="{Binding Value, ElementName=Root}" />
        <TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="{Binding Unit, ElementName=Root}" />
      </StackPanel>

      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" FontSize="11"
                 Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding MaxText, ElementName=Root}" />
    </Grid>
  </Viewbox>
</UserControl>
