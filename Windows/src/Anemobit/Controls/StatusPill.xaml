<UserControl x:Class="Anemobit.Controls.StatusPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             ToolTip="{Binding Detail, ElementName=Root}">
  <!-- Connection status pill: OK (green), connecting (yellow), error (red), not set up (gray). -->
  <Border CornerRadius="10" Padding="10,3" Background="{Binding FillBrush, ElementName=Root}">
    <StackPanel Orientation="Horizontal">
      <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding DotBrush, ElementName=Root}">
        <Ellipse.Effect>
          <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.8" Color="{Binding DotColor, ElementName=Root}" />
        </Ellipse.Effect>
      </Ellipse>
      <TextBlock Margin="6,0,0,0" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" Text="{Binding Text, ElementName=Root}" />
    </StackPanel>
  </Border>
</UserControl>
