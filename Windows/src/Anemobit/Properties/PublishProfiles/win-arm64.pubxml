<Project>

  <!-- Single framework-dependent executable: users install the .NET 10 Desktop Runtime (the MSI checks for it), which keeps the
       executable a few MB instead of bundling the whole runtime (about 70 MB). Compression and native library extraction only
       apply to self-contained builds, so they aren't set. WPF doesn't support trimming.
       Usage: dotnet publish src/Anemobit -p:PublishProfile=win-arm64 -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <!-- Executable only: don't copy API docs (.xml) or referenced projects' symbols (.pdb). -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <AllowedReferenceRelatedFileExtensions>-</AllowedReferenceRelatedFileExtensions>
    <PublishDir>bin\publish\win-arm64\</PublishDir>
  </PropertyGroup>

</Project>
