<UserControl x:Class="Anemobit.Views.InterfaceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Anemobit.Controls"
             xmlns:res="clr-namespace:Anemobit.Resources"
             x:Name="Root">
  <!-- Card for one interface: name, download / upload gauges, statistics (current / average / peak), and an optional 5-minute chart.
       DataContext is InterfaceTraffic. When Compact is true, statistics go below the gauges (same as InterfaceCard on macOS). -->
  <Border Style="{StaticResource Card}" Padding="18">
    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE968;" FontSize="15" Margin="0,0,8,0" />
        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
      </StackPanel>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition x:Name="StatsColumn" Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:RateGauge x:Name="DownloadGauge" Grid.Column="0" MaxHeight="200" Margin="0,0,8,0"
                            Title="{x:Static res:Strings.Download}" Glyph="&#xE74B;"
                            Value="{Binding InValue}" Unit="{Binding InUnit}" MaxText="{Binding GaugeMaxInText}"
                            Fraction="{Binding InFraction}" Color="{DynamicResource DownloadColor}"
                            Compact="{Binding Compact, ElementName=Root}" />
        <controls:RateGauge x:Name="UploadGauge" Grid.Column="1" MaxHeight="200" Margin="8,0,0,0"
                            Title="{x:Static res:Strings.Upload}" Glyph="&#xE74A;"
                            Value="{Binding OutValue}" Unit="{Binding OutUnit}" MaxText="{Binding GaugeMaxOutText}"
                            Fraction="{Binding OutFraction}" Color="{DynamicResource UploadColor}"
                            Compact="{Binding Compact, ElementName=Root}" />

        <!-- Statistics table: current / average / peak × download / upload -->
        <Grid x:Name="Stats" Grid.Column="2" Width="300" Margin="24,0,0,0" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.Resources>
            <Style x:Key="RowTitle" TargetType="TextBlock">
              <Setter Property="FontSize" Value="13" />
              <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
              <Setter Property="Margin" Value="0,4,12,4" />
            </Style>
            <Style x:Key="Value" TargetType="TextBlock">
              <Setter Property="FontSize" Value="13" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
              <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
              <Setter Property="Margin" Value="0,4,8,4" />
            </Style>
          </Grid.Resources>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,4">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE74B;" FontSize="11" Foreground="{DynamicResource DownloadBrush}" />
            <TextBlock Margin="4,0,0,0" FontSize="12" FontWeight="SemiBold" Text="{x:Static res:Strings.Download}" Foreground="{DynamicResource DownloadBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,4">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE74A;" FontSize="11" Foreground="{DynamicResource UploadBrush}" />
            <TextBlock Margin="4,0,0,0" FontSize="12" FontWeight="SemiBold" Text="{x:Static res:Strings.Upload}" Foreground="{DynamicResource UploadBrush}" />
          </StackPanel>
          <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Height="1" Fill="{DynamicResource CardStrokeBrush}" Margin="0,2" />

          <TextBlock Grid.Row="2" Style="{StaticResource RowTitle}" Text="{x:Static res:Strings.Current}" />
          <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding CurrentIn}" />
          <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding CurrentOut}" />

          <TextBlock Grid.Row="3" Style="{StaticResource RowTitle}" Text="{x:Static res:Strings.FiveMinuteAverage}" />
          <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding AverageIn}" />
          <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding AverageOut}" />

          <TextBlock Grid.Row="4" Style="{StaticResource RowTitle}" Text="{x:Static res:Strings.FiveMinutePeak}" />
          <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding PeakIn}" />
          <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Value}" Text="{Binding PeakOut}" />
        </Grid>
      </Grid>

      <!-- 5-minute chart -->
      <StackPanel Margin="0,16,0,0" Visibility="{Binding ShowsChart, ElementName=Root, Converter={StaticResource VisibleWhen}}">
        <DockPanel Margin="0,0,0,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Rectangle Width="14" Height="4" RadiusX="2" RadiusY="2" Fill="{DynamicResource DownloadBrush}" VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource Caption}" Margin="4,0,12,0" Text="{x:Static res:Strings.Download}" />
            <Rectangle Width="14" Height="4" RadiusX="2" RadiusY="2" Fill="{DynamicResource UploadBrush}" VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource Caption}" Margin="4,0,0,0" Text="{x:Static res:Strings.Upload}" />
          </StackPanel>
          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Text="{x:Static res:Strings.LastFiveMinutes}" />
        </DockPanel>
        <controls:TrafficChart Height="170" Traffic="{Binding}" Revision="{Binding Revision}" UnitStyle="{Binding UnitStyle}"
                               DownloadColor="{DynamicResource DownloadColor}" UploadColor="{DynamicResource UploadColor}"
                               GridBrush="{DynamicResource GridLineBrush}" LabelBrush="{DynamicResource SecondaryTextBrush}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
