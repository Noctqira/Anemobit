<Window x:Class="Anemobit.Views.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Anemobit.Controls"
        xmlns:res="clr-namespace:Anemobit.Resources"
        Title="Anemobit"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SizeToContent="Height" Width="380"
        Background="Transparent"
        BorderThickness="1" BorderBrush="{DynamicResource CardStrokeBrush}">
  <!-- Flyout that pops up from the notification area icon (or the floating window), with the same content as the menu bar popover on macOS:
       rates for the floating window interface, a mini traffic chart, connection status, Main Window / Settings / Quit. Hides when it loses focus. -->
  <Window.Resources>
    <Style x:Key="TileValue" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
  </Window.Resources>
  <Grid>
    <ContentControl ContentTemplate="{StaticResource ThemedBackgroundTemplate}" Focusable="False" />
    <StackPanel Margin="14">

      <!-- Not set up -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding IsConfigured, Converter={StaticResource CollapsedWhen}}">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE968;" Margin="0,0,8,0" />
            <TextBlock Text="{x:Static res:Strings.NotConfiguredTitle}" FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock Text="{x:Static res:Strings.NotConfiguredMessage}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,0,0,10" />
          <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Click="OnOpenSettings" Content="{x:Static res:Strings.OpenSettings}" />
        </StackPanel>
      </Border>

      <StackPanel Visibility="{Binding IsConfigured, Converter={StaticResource VisibleWhen}}">
        <DockPanel Margin="2,0,0,12">
          <controls:StatusPill DockPanel.Dock="Right" VerticalAlignment="Center" Kind="{Binding StatusKind}" Text="{Binding StatusText}"
                               Detail="{Binding StatusDetail}" OkColor="{DynamicResource AccentColor}" />
          <StackPanel>
            <TextBlock Text="{Binding FloatingInterface.Name}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Settings.Host}" Style="{StaticResource Caption}" />
          </StackPanel>
        </DockPanel>

        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" CornerRadius="14" Padding="10">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE74B;" FontSize="11" Foreground="{DynamicResource DownloadBrush}" />
                <TextBlock Margin="4,0,0,0" FontSize="12" FontWeight="SemiBold" Text="{x:Static res:Strings.Download}" Foreground="{DynamicResource DownloadBrush}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource TileValue}" MinWidth="72" TextAlignment="Right" Text="{Binding FloatingInterface.InValue, FallbackValue=--}" />
                <TextBlock Margin="4,0,0,4" VerticalAlignment="Bottom" Style="{StaticResource Caption}" Text="{Binding FloatingInterface.InUnit}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" CornerRadius="14" Padding="10">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE74A;" FontSize="11" Foreground="{DynamicResource UploadBrush}" />
                <TextBlock Margin="4,0,0,0" FontSize="12" FontWeight="SemiBold" Text="{x:Static res:Strings.Upload}" Foreground="{DynamicResource UploadBrush}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource TileValue}" MinWidth="72" TextAlignment="Right" Text="{Binding FloatingInterface.OutValue, FallbackValue=--}" />
                <TextBlock Margin="4,0,0,4" VerticalAlignment="Bottom" Style="{StaticResource Caption}" Text="{Binding FloatingInterface.OutUnit}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <Border Style="{StaticResource Card}" CornerRadius="14" Padding="10" Margin="0,0,0,10">
          <controls:TrafficChart Height="120" Compact="True" Traffic="{Binding FloatingInterface}" Revision="{Binding FloatingInterface.Revision}"
                                 UnitStyle="{Binding Settings.UnitStyle}"
                                 DownloadColor="{DynamicResource DownloadColor}" UploadColor="{DynamicResource UploadColor}"
                                 GridBrush="{DynamicResource GridLineBrush}" LabelBrush="{DynamicResource SecondaryTextBrush}" />
        </Border>

        <!-- Error message, or device uptime -->
        <StackPanel Orientation="Horizontal" Margin="2,0,0,10" Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Foreground="IndianRed" Margin="0,0,6,0" VerticalAlignment="Top" />
          <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="IndianRed" TextWrapping="Wrap" MaxWidth="320" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding DeviceUpText}" Value="">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="Failed">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" FontSize="11" Margin="0,0,5,0" Foreground="{DynamicResource SecondaryTextBrush}" />
          <TextBlock Style="{StaticResource Caption}" Text="{Binding DeviceUpText}" />
        </StackPanel>
      </StackPanel>

      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Quit}" Click="OnQuit" Padding="10,4" />
        <StackPanel Orientation="Horizontal">
          <Button Content="{x:Static res:Strings.OpenMainWindow}" Click="OnOpenMainWindow" Padding="10,4" Margin="0,0,8,0" />
          <Button Content="{x:Static res:Strings.SettingsEllipsis}" Click="OnOpenSettings" Padding="10,4" />
        </StackPanel>
      </DockPanel>
    </StackPanel>
  </Grid>
</Window>
