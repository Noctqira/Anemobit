<Window x:Class="Anemobit.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Anemobit.Resources"
        Title="{x:Static res:Strings.AboutAnemobit}"
        Icon="/Anemobit;component/Assets/Anemobit.ico"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
  <!-- About: icon, version, summary, compatibility, links (website, report an issue, privacy policy, license), copyright (same as macOS / iOS). -->
  <Grid>
    <ContentControl ContentTemplate="{StaticResource ThemedBackgroundTemplate}" Focusable="False" />
    <StackPanel Margin="20,24,20,20">
      <Image Source="/Anemobit;component/Assets/AppIcon.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality" />
      <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="20" FontWeight="SemiBold" Text="Anemobit" />
      <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Style="{StaticResource Caption}" FontSize="13" />

      <Border Style="{StaticResource Card}" Margin="0,20,0,0">
        <StackPanel>
          <TextBlock Text="{x:Static res:Strings.AboutSummary}" TextWrapping="Wrap" />
          <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{x:Static res:Strings.AboutCompatibility}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource SectionCard}" Margin="0,14,0,0">
        <StackPanel>
          <Button Style="{StaticResource RowButton}" Click="OnOpenLink" Tag="https://github.com/noctqira/Anemobit">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12" Foreground="{DynamicResource TertiaryTextBrush}" />
              <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" Margin="0,0,10,0" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{x:Static res:Strings.Website}" />
            </DockPanel>
          </Button>
          <Rectangle Style="{StaticResource RowDivider}" />
          <Button Style="{StaticResource RowButton}" Click="OnOpenLink" Tag="https://github.com/noctqira/Anemobit/issues">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12" Foreground="{DynamicResource TertiaryTextBrush}" />
              <TextBlock Style="{StaticResource Icon}" Text="&#xED15;" Margin="0,0,10,0" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{x:Static res:Strings.ReportIssue}" />
            </DockPanel>
          </Button>
          <Rectangle Style="{StaticResource RowDivider}" />
          <Button Style="{StaticResource RowButton}" Click="OnOpenLink" Tag="https://github.com/noctqira/Anemobit/blob/main/PRIVACY.md">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12" Foreground="{DynamicResource TertiaryTextBrush}" />
              <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" Margin="0,0,10,0" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{x:Static res:Strings.PrivacyPolicy}" />
            </DockPanel>
          </Button>
          <Rectangle Style="{StaticResource RowDivider}" />
          <Button Style="{StaticResource RowButton}" Click="OnOpenLink" Tag="https://github.com/noctqira/Anemobit/blob/main/LICENSE">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12" Foreground="{DynamicResource TertiaryTextBrush}" />
              <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Margin="0,0,10,0" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{x:Static res:Strings.License}" />
            </DockPanel>
          </Button>
        </StackPanel>
      </Border>

      <DockPanel Margin="0,18,0,0">
        <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Close}" IsCancel="True" Click="OnClose" MinWidth="80" />
        <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}" Text="© 2026 Noctqira" />
      </DockPanel>
    </StackPanel>
  </Grid>
</Window>
