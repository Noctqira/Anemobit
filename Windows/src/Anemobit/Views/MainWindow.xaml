<Window x:Class="Anemobit.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Anemobit.Controls"
        xmlns:views="clr-namespace:Anemobit.Views"
        xmlns:res="clr-namespace:Anemobit.Resources"
        x:Name="Root"
        Title="Anemobit"
        Icon="/Anemobit;component/Assets/Anemobit.ico"
        Width="960" Height="780" MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterScreen">
  <!-- Main window: one card per interface (same as the macOS main window). The background is Mica with a translucent lavender tint. -->
  <Grid>
    <ContentControl ContentTemplate="{StaticResource ThemedBackgroundTemplate}" Focusable="False" />

    <DockPanel>
      <!-- Title bar: one interface shows its name with the device as subtitle; several show the device with the interface count as subtitle. -->
      <Grid DockPanel.Dock="Top" Margin="24,14,20,10">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"
                     Visibility="{Binding Subtitle, Converter={StaticResource VisibleWhen}}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <controls:StatusPill Kind="{Binding StatusKind}" Text="{Binding StatusText}" Detail="{Binding StatusDetail}"
                               OkColor="{DynamicResource AccentColor}" Margin="0,0,10,0" VerticalAlignment="Center"
                               Visibility="{Binding IsConfigured, Converter={StaticResource VisibleWhen}}" />
          <Button Click="OnOpenSettings" ToolTip="{x:Static res:Strings.Settings}" Padding="8,6"
                  AutomationProperties.Name="{x:Static res:Strings.Settings}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="16" />
          </Button>
        </StackPanel>
      </Grid>

      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1000" Margin="20,4,20,24">
          <!-- Not set up -->
          <Border Style="{StaticResource Card}" MaxWidth="440" Margin="0,40,0,0"
                  Visibility="{Binding IsConfigured, Converter={StaticResource CollapsedWhen}}">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE968;" FontSize="15" Margin="0,0,8,0" />
                <TextBlock Text="{x:Static res:Strings.NotConfiguredTitle}" FontSize="16" FontWeight="SemiBold" />
              </StackPanel>
              <TextBlock Text="{x:Static res:Strings.NotConfiguredMessage}" TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12" />
              <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Click="OnOpenSettings"
                      Content="{x:Static res:Strings.OpenSettings}" />
            </StackPanel>
          </Border>

          <ItemsControl ItemsSource="{Binding Interfaces}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <!-- DataTemplate has its own name scope where ElementName can't find the window, so use RelativeSource. -->
                <views:InterfaceCard Margin="0,0,0,16"
                                     Compact="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=views:MainWindow}}"
                                     ShowsChart="{Binding DataContext.ShowsCharts, RelativeSource={RelativeSource AncestorType=views:MainWindow}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Device uptime and last update time -->
          <DockPanel Margin="4,0" Visibility="{Binding IsConfigured, Converter={StaticResource VisibleWhen}}">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding UpdatedText}" />
            <StackPanel Orientation="Horizontal" Visibility="{Binding DeviceUpText, Converter={StaticResource VisibleWhen}}">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" FontSize="11" Margin="0,0,5,0"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
              <TextBlock Style="{StaticResource Caption}" Text="{Binding DeviceUpText}" />
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
